{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familia-akt-control-canastas",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "familia-akt-control-canastas-db",
      "database_id": "a4cd56af-4a9d-417b-b96c-0c93cf376a11"
    }
  ]
}
